---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogDescription = description ?? '26 Brains builds integrations and custom software — AWS, Current RMS, Maxoptra, Pipedrive, REST and event-driven services, and AI workflows.';
---
<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={ogDescription} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content="26 Brains" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">

    <header class="bg-[#FAFAFC] border-b border-[#E4E4EC]">
      <nav class="max-w-3xl mx-auto px-6 py-5 flex items-center">
        <a href="/" class="flex items-center gap-2.5 font-[family-name:var(--font-sans)] font-600 text-[#191946] text-xl tracking-tight no-underline mr-auto hover:opacity-75 transition-opacity">
          <img src="/logo.png" alt="" width="40" height="40" class="w-10 h-10" />
          26 Brains
        </a>
        <div class="flex items-center gap-6 sm:gap-8">
          <a href="/integrations" class="font-[family-name:var(--font-sans)] text-base font-400 text-[#23233F] hover:text-[#3D3D7A] transition-colors no-underline">🔌 Integrations</a>
          <a href="/#contact" class="font-[family-name:var(--font-sans)] text-base font-400 text-[#23233F] hover:text-[#3D3D7A] transition-colors no-underline">✉️ Contact</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-3xl mx-auto w-full px-6 py-12 md:py-16">
      <slot />
    </main>

    <footer class="border-t border-[#E4E4EC] mt-auto">
      <div class="max-w-3xl mx-auto px-6 py-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <span class="font-[family-name:var(--font-sans)] text-sm text-[#6B6B80]">© {new Date().getFullYear()} 26 Brains Ltd · Registered in England and Wales, company no. 14800970</span>
        <div class="flex items-center gap-6">
          <a href="https://www.youtube.com/@26brains" class="font-[family-name:var(--font-sans)] text-sm text-[#6B6B80] hover:text-[#23233F] transition-colors no-underline">YouTube</a>
          <a href="https://github.com/26brains" class="font-[family-name:var(--font-sans)] text-sm text-[#6B6B80] hover:text-[#23233F] transition-colors no-underline">GitHub</a>
        </div>
      </div>
    </footer>

    <Analytics />
  </body>
</html>
