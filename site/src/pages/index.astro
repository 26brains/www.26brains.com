---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'Integrations',
    desc: 'Connecting the business systems you already use, so data moves between them without anyone copying it by hand. One-way feeds, two-way sync, webhooks and scheduled jobs.',
  },
  {
    title: 'Custom software development',
    desc: 'Backend services, internal tools and automation built around your workflow, your data model and your edge cases. You own the code.',
  },
  {
    title: 'REST and event-driven services',
    desc: 'APIs, queues and event pipelines designed to handle retries, rate limits and partial failure — not just the happy path.',
  },
  {
    title: 'Integrated AI workflows',
    desc: 'AI built into existing processes rather than bolted on beside them, including MCP integrations that give AI assistants controlled access to your systems and data.',
  },
];

const systems = [
  { label: 'AWS', desc: 'Lambda, ECS, SQS, SNS, DynamoDB, RDS and the rest of the stack', href: undefined },
  { label: 'Current RMS', desc: 'Rental and events management', href: '/integrations/current-rms' },
  { label: 'Maxoptra', desc: 'Route planning and delivery', href: '/integrations/maxoptra' },
  { label: 'Pipedrive', desc: 'CRM and sales pipeline', href: '/integrations/pipedrive' },
];

const inputClass = 'w-full px-4 py-3 border border-[#E4E4E4] rounded-none bg-white text-[#2B2B2B] font-[family-name:var(--font-sans)] text-sm focus:outline-none focus:border-[#555555] transition-colors';
const labelClass = 'font-[family-name:var(--font-sans)] text-sm font-500 text-[#2B2B2B] block mb-2';
---
<Base title="26 Brains — Integrations and Custom Software Development">

  <section class="mb-16">
    <h1 class="font-[family-name:var(--font-sans)] text-3xl font-600 tracking-tight text-[#2B2B2B] mb-6">Integrations and custom software.</h1>
    <p class="text-xl leading-relaxed text-[#2B2B2B] max-w-lg">
      26 Brains builds the software that sits between business systems — integrations, backend services and AI workflows that keep data where it needs to be.
    </p>
    <p class="mt-4 text-xl leading-relaxed text-[#2B2B2B] max-w-lg">
      If your team is re-entering data, chasing updates between tools, or working around gaps in the systems you depend on, that is the problem we fix.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="font-[family-name:var(--font-sans)] text-xs font-500 uppercase tracking-widest text-[#737373] mb-6">🛠️ What we do</h2>
    <div class="space-y-0">
      {services.map(({ title, desc }) => (
        <div class="border-t border-[#E4E4E4] py-6">
          <h3 class="font-[family-name:var(--font-sans)] font-600 text-lg text-[#2B2B2B] mb-2">{title}</h3>
          <p class="leading-relaxed text-[#2B2B2B] max-w-lg">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-[family-name:var(--font-sans)] text-xs font-500 uppercase tracking-widest text-[#737373] mb-6">🔌 Specialist platforms</h2>
    <ul class="space-y-2">
      {systems.map(({ label, desc, href }) => (
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-0 sm:gap-3">
          {href
            ? <a href={href} class="font-[family-name:var(--font-sans)] font-500 text-[#2B2B2B] underline decoration-[#B5B5B5] underline-offset-4 hover:decoration-[#2B2B2B] transition-colors">{label}</a>
            : <span class="font-[family-name:var(--font-sans)] font-500 text-[#2B2B2B]">{label}</span>}
          <span class="font-[family-name:var(--font-sans)] text-sm text-[#737373]">{desc}</span>
        </li>
      ))}
    </ul>
    <div class="mt-8">
      <a href="/integrations" class="font-[family-name:var(--font-sans)] text-sm text-[#2B2B2B] underline decoration-[#B5B5B5] underline-offset-4 hover:decoration-[#2B2B2B] transition-colors">All integrations →</a>
    </div>
  </section>

  <section id="contact" class="max-w-lg scroll-mt-8">
    <h2 class="font-[family-name:var(--font-sans)] text-xs font-500 uppercase tracking-widest text-[#737373] mb-6">✉️ Contact</h2>
    <p class="leading-relaxed text-[#2B2B2B] mb-10">
      Tell us which systems you run and where the friction is. We'll tell you what's possible.
    </p>

    <form action="https://formspree.io/f/mdovyqog" method="POST" class="space-y-6">
      <input type="hidden" name="_subject" value="26brains.com enquiry" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <div>
        <label for="name" class={labelClass}>Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" class={inputClass} />
      </div>

      <div>
        <label for="email" class={labelClass}>Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" class={inputClass} />
      </div>

      <div>
        <label for="company" class={labelClass}>Company <span class="text-[#737373] font-400">(optional)</span></label>
        <input type="text" id="company" name="company" autocomplete="organization" class={inputClass} />
      </div>

      <div>
        <label for="message" class={labelClass}>Message</label>
        <textarea id="message" name="message" required rows="6" class={`${inputClass} resize-none`}></textarea>
      </div>

      <button
        type="submit"
        class="font-[family-name:var(--font-sans)] text-sm font-500 bg-[#2B2B2B] text-[#FAFAFA] px-6 py-3 hover:bg-[#555555] transition-colors cursor-pointer border-0"
      >
        Send message
      </button>
      <p id="contact-error" class="font-[family-name:var(--font-sans)] text-sm text-[#B42318]" role="alert" hidden></p>
    </form>
  </section>

  <script>
    // Formspree's free plan ignores _next, so submit via fetch and redirect ourselves.
    // Without JS the form still posts normally and lands on Formspree's own thanks page.
    const form = document.querySelector<HTMLFormElement>('#contact form');
    const error = document.getElementById('contact-error');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !error) return;
      error.hidden = true;
      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
        window.location.href = '/thanks';
      } catch {
        error.textContent = 'Sorry, the message could not be sent. Please try again in a moment.';
        error.hidden = false;
        button.disabled = false;
        button.textContent = 'Send message';
      }
    });
  </script>

</Base>
