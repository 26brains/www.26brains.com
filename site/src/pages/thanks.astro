---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks — 26 Brains">

  <div class="max-w-lg">
    <h1 class="font-[family-name:var(--font-sans)] text-3xl font-600 tracking-tight text-[#2B2B2B] mb-4">Thanks.</h1>
    <p class="leading-relaxed text-[#737373]">
      Message received. We'll get back to you shortly.
    </p>
    <div class="mt-10">
      <a href="/" class="font-[family-name:var(--font-sans)] text-sm text-[#2B2B2B] underline decoration-[#B5B5B5] underline-offset-4 hover:decoration-[#2B2B2B] transition-colors">← Back home</a>
    </div>
  </div>

</Base>
