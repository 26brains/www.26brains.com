---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks — 26 Brains">

  <div class="max-w-lg">
    <h1 class="font-[family-name:var(--font-sans)] text-3xl font-600 tracking-tight text-[#23233F] mb-4">Thanks.</h1>
    <p class="leading-relaxed text-[#6B6B80]">
      Message received. We'll get back to you shortly.
    </p>
    <div class="mt-10">
      <a href="/" class="font-[family-name:var(--font-sans)] text-sm text-[#23233F] underline decoration-[#B9B9D0] underline-offset-4 hover:decoration-[#23233F] transition-colors">← Back home</a>
    </div>
  </div>

</Base>
